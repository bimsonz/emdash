---
/**
 * Portable Text columns block
 *
 * Lays its columns out side by side, stacking them on narrow screens unless
 * they wrap, and renders each column's blocks with the components of the
 * surrounding Portable Text.
 */
import type { PortableTextColumnsBlock } from "@emdash-cms/admin/portable-text-columns";

import { columnClasses, columnsClasses, columnStyle } from "./columns-layout.js";
import PortableText from "./PortableText.astro";
import { renderPropsOf } from "./portable-text-render-props.js";

export interface Props {
	node: PortableTextColumnsBlock;
}

const { node } = Astro.props;
const columns = Array.isArray(node?.columns) ? node.columns : [];
const renderProps = renderPropsOf(node) ?? {};

if (!columns.length) {
	return null;
}
---

<div class:list={columnsClasses(node)}>
	{
		columns.map((column) => (
			<div class:list={columnClasses(column ?? {})} style={columnStyle(column ?? {})}>
				<PortableText
					{...renderProps}
					value={Array.isArray(column?.content) ? column.content : []}
				/>
			</div>
		))
	}
</div>

<style>
	.emdash-columns {
		display: flex;
		gap: 2rem;
		margin: 1.5rem 0;
	}
	.emdash-columns--gap-none {
		gap: 0;
	}
	.emdash-columns--gap-sm {
		gap: 1rem;
	}
	.emdash-columns--gap-lg {
		gap: 3rem;
	}
	.emdash-columns--align-top {
		align-items: flex-start;
	}
	.emdash-columns--align-center {
		align-items: center;
	}
	.emdash-columns--align-bottom {
		align-items: flex-end;
	}
	.emdash-columns--wrap {
		flex-wrap: wrap;
	}
	.emdash-column {
		flex: 1;
		min-width: 0;
	}
	.emdash-column--span-2 {
		flex-grow: 2;
	}
	.emdash-column--span-3 {
		flex-grow: 3;
	}
	.emdash-columns--wrap > .emdash-column {
		min-width: min(100%, 12rem);
	}
	.emdash-column > :global(:first-child) {
		margin-top: 0;
	}
	.emdash-column > :global(:last-child) {
		margin-bottom: 0;
	}
	@media (max-width: 768px) {
		.emdash-columns:not(.emdash-columns--wrap) {
			flex-direction: column;
		}
		.emdash-columns:not(.emdash-columns--wrap, .emdash-columns--gap-none) {
			gap: 1rem;
		}
	}
</style>
